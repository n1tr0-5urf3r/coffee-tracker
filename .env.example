# Application branding (read by the frontend container at startup)
APP_NAME="Coffee Tracker"
ORGANIZATION_NAME="the community"
ORGANIZATION_SHORT_NAME=Community
STAFF_LABEL=staff
OIDC_LOGIN_LABEL="Sign in with OpenID Connect"
LOGO_URL=
ALLOWED_HOSTS=
BRANDING_DIR=./branding

# Local services
DATABASE_URL=sqlite://coffee-tracker.db
BIND_ADDR=0.0.0.0:3124
SESSION_SECRET=replace-with-a-long-random-value
PUBLIC_BASE_URL=http://localhost:3123
FRONTEND_BASE_URL=http://localhost:3123
API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3124
TIMEZONE=Europe/Berlin

# Authentication
GITLAB_BASE_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_SCOPES="read_user read_api email"
AUTHENTIK_ISSUER_URL=
AUTHENTIK_OAUTH_CLIENT_ID=
AUTHENTIK_OAUTH_CLIENT_SECRET=
AUTHENTIK_OAUTH_SCOPES="openid email profile groups"
AUTH_ALLOWED_GROUPS=coffee-users,coffee-admins
AUTH_STAFF_GROUPS=coffee-admins

# Optional integrations
MATTERMOST_WEBHOOK_URL=
MATRIX_WEBHOOK_URL=
PAYPAL_LINK=
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
SMTP_SECURITY=none

# Optional host mappings for private DNS deployments (host:ip)
GITLAB_EXTRA_HOST=gitlab.example.org:127.0.0.1
MATTERMOST_EXTRA_HOST=mattermost.example.org:127.0.0.1
MATRIX_EXTRA_HOST=matrix.example.org:127.0.0.1
AUTHENTIK_EXTRA_HOST=auth.example.org:127.0.0.1
